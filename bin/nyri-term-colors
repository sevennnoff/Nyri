#!/usr/bin/env python3
import os, colorsys, json, re, subprocess, sys
from pathlib import Path

HOME = Path.home()
theme = Path(sys.argv[1] if len(sys.argv) > 1 else
             Path(os.environ.get("NYRI_STATE", Path.home() / ".local/state/nyri")) / "theme.json")
data = json.loads(theme.read_text())
c, dark = data["colors"], data.get("mode", "dark") != "light"

def rgb(h):
    h = h.lstrip("#")
    return [int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)]

def hexc(r, g, b):
    return "#" + "".join(f"{round(max(0, min(1, v)) * 255):02x}" for v in (r, g, b))

prim_h = colorsys.rgb_to_hls(*rgb(c["primary"]))[0]
def ansi(hue_deg, bright):
    h = hue_deg / 360
    d = ((prim_h - h + 0.5) % 1) - 0.5
    h = (h + 0.33 * d) % 1
    if dark:
        l, s = (0.86, 0.55) if bright else (0.72, 0.32)
    else:
        l, s = (0.30, 0.55) if bright else (0.40, 0.40)
    return hexc(*colorsys.hls_to_rgb(h, l, s))

hues = {"red": 8, "green": 130, "yellow": 48, "blue": 215, "magenta": 305, "cyan": 180}
pal = [c["surface"], ansi(8, 0), ansi(130, 0), ansi(48, 0), ansi(215, 0), ansi(305, 0), ansi(180, 0), c["on_surface_variant"],
       c["outline"], ansi(8, 1), ansi(130, 1), ansi(48, 1), ansi(215, 1), ansi(305, 1), ansi(180, 1), c["on_surface"]]
fg, bg = c["on_surface"], c["surface"]

kitty = HOME / ".config/kitty/current-theme.conf"
kitty.write_text(f"""# Generated by ~/nyri/bin/nyri-term-colors from the wallpaper palette — do not edit.

foreground              {fg}
background              {bg}
selection_foreground    {c["on_secondary_container"]}
selection_background    {c["secondary_container"]}
cursor                  {c["primary"]}
cursor_text_color       {c["on_primary"]}
url_color               {c["primary"]}

active_border_color     {c["primary"]}
inactive_border_color   {c["outline_variant"]}
bell_border_color       {c["error"]}

active_tab_foreground   {c["on_primary_container"]}
active_tab_background   {c["primary_container"]}
inactive_tab_foreground {c["on_surface_variant"]}
inactive_tab_background {c["surface_container"]}
tab_bar_background      {bg}

mark1_foreground {c["on_primary"]}
mark1_background {c["primary"]}
mark2_foreground {c["on_secondary_container"]}
mark2_background {c["secondary_container"]}

""" + "\n".join(f"color{i:<3} {v}" for i, v in enumerate(pal)) + "\n")

seq = HOME / ".local/state/quickshell/user/generated/terminal/sequences.txt"
seq.parent.mkdir(parents=True, exist_ok=True)
esc = "\x1b]"; st = "\x1b\\"
seq.write_text("".join(f"{esc}4;{i};{v}{st}" for i, v in enumerate(pal))
               + f"{esc}10;{fg}{st}{esc}11;{bg}{st}{esc}12;{c['primary']}{st}")

star = HOME / ".config/starship.toml"
if star.exists():
    text = star.read_text()
    values = {
        "primary": c["primary"], "onPrimary": c["on_primary"],
        "secondary": c["secondary"], "onSecondary": c["on_secondary"],
        "tertiary": c["tertiary"], "onTertiary": c["on_tertiary"],
        "surface": c["surface"], "onSurface": c["on_surface"],
        "background": bg, "foreground": fg,
        "black": pal[0], "red": pal[1], "green": pal[2], "yellow": pal[3],
        "blue": pal[4], "magenta": pal[5], "cyan": pal[6], "white": pal[7],
        "bright_black": pal[8], "bright_red": pal[9], "bright_green": pal[10], "bright_yellow": pal[11],
        "bright_blue": pal[12], "bright_magenta": pal[13], "bright_cyan": pal[14], "bright_white": pal[15],
    }
    head, sep, block = text.partition("[palettes.ii]")
    if sep:
        end = re.search(r"\n\[", block)
        body, rest = (block[:end.start()], block[end.start():]) if end else (block, "")
        for k, v in values.items():
            body = re.sub(rf"(?m)^{re.escape(k)}\s*=\s*'[^']*'", f"{k} = '{v}'", body)
        star.write_text(head + sep + body + rest)

subprocess.run(["pkill", "-USR1", "-x", "kitty"], capture_output=True)
