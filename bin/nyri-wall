#!/usr/bin/env python3
"""Flat vector wallpapers with swappable palettes (after the wally app).

    nyri-wall styles                                 JSON list of styles
    nyri-wall palettes                               JSON list of palettes
    nyri-wall make STYLE PALETTE SEED OUT.svg [--size WxH] [--grid]
    nyri-wall thumbs PALETTE SEED DIR [--grid]       every style as DIR/<style>.svg
    nyri-wall apply STYLE PALETTE SEED [--grid]      render, save, recolor the desktop

PALETTE is a palette name, or a colour — "#7c4dff" (light) or "#7c4dff/dark"
— to build the whole palette from that one hue. --grid adds graph paper.

A wallpaper is a pure function of (style, palette, seed, size): no effects,
no gradients, just shapes — so any palette can be swapped in later. `apply`
writes $NYRI_DATA/walls/<style>-<palette>-<seed>.{svg,png} (NYRI_DATA
defaults to ~/.local/share/nyri; the PNG is what matugen reads) and runs
nyri-theme on it.
"""
import colorsys, json, math, os, random, subprocess, sys
from pathlib import Path

W, H = 2880, 1800

def P(group, name, *c):
    return {"group": group, "name": name, "colors": ["#%06x" % (v & 0xFFFFFF) for v in c]}

