#!/usr/bin/env python3
import os, select, struct, sys, time
from pathlib import Path

EVENT = struct.Struct("llHHi")
EV_KEY, EV_LED, KEY_CAPSLOCK, LED_CAPSL = 1, 0x11, 58, 1

leds = sorted(Path("/sys/class/leds").glob("*::capslock"))
devices = {}
for led in leds:
    for ev in (led / "device").glob("event*"):
        try:
            devices[os.open(f"/dev/input/{ev.name}", os.O_RDONLY | os.O_NONBLOCK)] = led
        except OSError:
            pass

def state():
    return "1" if any((l / "brightness").read_text().strip() != "0" for l in leds) else "0"

if not devices:
    sys.exit(0)

last = state()
print(last, flush=True)

def report(now):
    global last
    if now != last:
        last = now
        print(now, flush=True)

pending = 0.0
while True:
    ready, _, _ = select.select(list(devices), [], [], 0.08 if pending else None)
    led = None
    for fd in ready:
        try:
            data = os.read(fd, EVENT.size * 64)
        except BlockingIOError:
            continue
        for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
            _, _, etype, code, value = EVENT.unpack_from(data, off)
            if etype == EV_LED and code == LED_CAPSL:
                led = "1" if value else "0"
            elif etype == EV_KEY and code == KEY_CAPSLOCK and value == 1:
                pending = time.monotonic() + 0.6
    if led is not None:
        pending = 0.0
        report(led)
    elif pending:
        report(state())
        if time.monotonic() > pending:
            pending = 0.0
