// Geometry follows the M3 tokens: 12dp spacing between panes, 3dp focus
// indicator, and level-3 elevation for the window shadow.

layout {
    gaps 12
    center-focused-column "on-overflow"
    always-center-single-column
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
    }

    border {
        off
    }

    shadow {
        on
        softness 24
        spread 2
        offset x=0 y=6
        draw-behind-window true
    }

    tab-indicator {
        place-within-column
        gap 6
        width 4
        length total-proportion=0.5
        position "left"
        corner-radius 2
    }

    insert-hint {
    }

    struts {
    }
}

overview {
    zoom 0.75
    workspace-shadow {
        softness 40
        spread 6
        offset x=0 y=12
        color "#00000060"
    }
}
